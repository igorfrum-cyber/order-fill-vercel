{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node frontend/scripts/ui-regression.mjs touched"
      }
    ],
    "stop": [
      {
        "command": "node frontend/scripts/ui-regression.mjs stop",
        "loop_limit": 5,
        "timeout": 30
      }
    ]
  }
}
