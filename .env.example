DATABASE_URL=postgres://order_fill:order_fill@postgres:5432/order_fill?sslmode=disable
QUEUE_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=order-fill
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
DOCUMENT_HEALTH_URL=http://127.0.0.1:8081/healthz
API_PUBLIC_URL=http://127.0.0.1:3200
API_ALLOWED_ORIGINS=http://127.0.0.1:3200,http://localhost:3200
# Company login pages: http://<slug>.localhost:3200 locally, or http://<IP>:3200/c/<slug> on an IP host.
# Same Wi-Fi (phone/tablet): add http://<LAN-IP>:3200, or set API_ALLOWED_ORIGINS=* while APP_ENV=local.
# Face ID on iPhone: make lan-https, then trust the local certificate on the phone.
# Example: API_ALLOWED_ORIGINS=http://127.0.0.1:3200,http://localhost:3200,http://192.168.31.108:3200
BOOTSTRAP_ADMIN_LOGIN=admin
TWOFA_MASTER_KEY=local-dev-twofa-master-key
SESSION_COOKIE_SECURE=false
# Passkeys (Face ID, Touch ID, Windows Hello, 1Password, Bitwarden, security keys).
# Leave WEBAUTHN_RP_ID empty locally so http://127.0.0.1:3200 uses that IP
# and http://<slug>.localhost:3200 uses <slug>.localhost as the relying party.
# Do not set WEBAUTHN_RP_ID=localhost: browsers reject it for company subdomains.
WEBAUTHN_RP_DISPLAY_NAME=Order Fill
# Production HTTPS (DuckDNS or any hostname). Then: make https
# Stop: make down locally, make https-down on the server.
# 1. Create a name at https://www.duckdns.org (e.g. orderfill.duckdns.org)
# 2. Point it at the server public IP. Open ports 80 and 443.
# 3. Uncomment and fill:
# PUBLIC_HOST=orderfill.duckdns.org
# APP_ENV=production
# API_ALLOWED_ORIGINS=https://orderfill.duckdns.org
# SESSION_COOKIE_SECURE=true
# WEBAUTHN_RP_ID=orderfill.duckdns.org
# SESSION_COOKIE_DOMAIN=orderfill.duckdns.org
# Company login: https://orderfill.duckdns.org/c/<slug>
# Paid domain with wildcard DNS can still use https://<slug>.example.com
