#!/usr/bin/env bash
# Sync generated README tables on every commit. Full verify only on artemch.
set -euo pipefail

echo "==> pre-commit: sync docs from code"
node scripts/sync-docs.mjs --write
git add backend/services/*/README.md

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [[ "$branch" != "artemch" ]]; then
  exit 0
fi

echo "==> pre-commit: make verify (branch artemch)"
make verify
