{
  "name": "@order-fill/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3200",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3200",
    "test": "node --test \"src/**/*.test.js\"",
    "test:component": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:ui": "npm run test && npm run test:component && npm run test:e2e && node ./scripts/ui-regression.mjs mark",
    "lint": "node scripts/lint.mjs && eslint .",
    "verify": "npm run lint && npm run test && npm run test:component && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.12",
    "vite": "^7.2.4",
    "vitest": "^5.0.0"
  }
}
