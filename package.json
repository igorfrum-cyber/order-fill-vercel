{
  "name": "order-fill-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3200",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3200",
    "test:frontend": "node --test src/**/*.test.js",
    "verify:api": "cd services/api-service && GOCACHE=/private/tmp/order-fill-go-cache go test ./...",
    "verify:document": "cd services/document-service && GOCACHE=/private/tmp/order-fill-go-cache go test ./...",
    "verify": "npm run test:frontend && npm run build && npm run verify:api && npm run verify:document",
    "precommit": "npm run verify"
  },
  "dependencies": {
    "vite": "^7.2.4"
  }
}
